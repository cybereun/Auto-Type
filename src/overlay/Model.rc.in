#include <winver.h>
101 RCDATA "@CMAKE_CURRENT_SOURCE_DIR@/resources/model-v2.dat"
201 ICON "@CMAKE_CURRENT_SOURCE_DIR@/resources/autotype.ico"
VS_VERSION_INFO VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "cybereun"
      VALUE "FileDescription", "Auto-Type Korean and English typing assistant"
      VALUE "ProductName", "Auto-Type"
      VALUE "FileVersion", "@PROJECT_VERSION@"
      VALUE "ProductVersion", "@PROJECT_VERSION@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
