// Generated into the build directory by CMake. The language model is embedded so the input method is a single DLL.
#include <winver.h>

101 RCDATA "@CMAKE_CURRENT_SOURCE_DIR@/resources/model-v2.dat"


VS_VERSION_INFO VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@, @PROJECT_VERSION_MINOR@, @PROJECT_VERSION_PATCH@, 0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@, @PROJECT_VERSION_MINOR@, @PROJECT_VERSION_PATCH@, 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "cybereun"
      VALUE "FileDescription", "Auto-Type Korean/English input method"
      VALUE "ProductName", "Auto-Type"
      VALUE "FileVersion", "@PROJECT_VERSION@"
      VALUE "ProductVersion", "@PROJECT_VERSION@"
      VALUE "LegalCopyright", "MIT License"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
